{
  "id": "./",
  "name": "趣日常 · 日常有点意思",
  "short_name": "趣日常",
  "description": "让日常小事多一点乐趣的口袋工具箱：随心选、今天吃什么、搞笑倒计时",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#f7f6f2",
  "theme_color": "#f7f6f2",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "随心选",
      "url": "./#/picker",
      "icons": [{ "src": "icons/picker-192.png", "sizes": "192x192" }]
    },
    {
      "name": "今天吃什么",
      "url": "./#/kitchen",
      "icons": [{ "src": "icons/kitchen-192.png", "sizes": "192x192" }]
    },
    {
      "name": "搞笑倒计时",
      "url": "./#/timer",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
